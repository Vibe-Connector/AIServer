:begin
CREATE FULLTEXT INDEX item_search FOR (n:Movie|Music|Coffee|Lighting) ON EACH [n.`name`,n.`item_key`];
CREATE RANGE INDEX FOR (n:Companion) ON (n.companion_key);
CREATE RANGE INDEX FOR (n:Mood) ON (n.keyword_value);
CREATE RANGE INDEX FOR (n:Place) ON (n.place_key);
CREATE RANGE INDEX FOR (n:Time) ON (n.time_key);
CREATE RANGE INDEX FOR (n:Weather) ON (n.weather_key);
CREATE CONSTRAINT category_category_id FOR (node:Category) REQUIRE (node.category_id) IS UNIQUE;
CREATE CONSTRAINT coffee_item_id FOR (node:Coffee) REQUIRE (node.item_id) IS UNIQUE;
CREATE CONSTRAINT companion_companion_id FOR (node:Companion) REQUIRE (node.companion_id) IS UNIQUE;
CREATE CONSTRAINT genre_name FOR (node:Genre) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT lighting_item_id FOR (node:Lighting) REQUIRE (node.item_id) IS UNIQUE;
CREATE CONSTRAINT mood_keyword_id FOR (node:Mood) REQUIRE (node.keyword_id) IS UNIQUE;
CREATE CONSTRAINT movie_item_id FOR (node:Movie) REQUIRE (node.item_id) IS UNIQUE;
CREATE CONSTRAINT music_item_id FOR (node:Music) REQUIRE (node.item_id) IS UNIQUE;
CREATE CONSTRAINT place_place_id FOR (node:Place) REQUIRE (node.place_id) IS UNIQUE;
CREATE CONSTRAINT time_time_id FOR (node:Time) REQUIRE (node.time_id) IS UNIQUE;
CREATE CONSTRAINT vibe_pattern_id FOR (node:VibePattern) REQUIRE (node.pattern_id) IS UNIQUE;
CREATE CONSTRAINT weather_weather_id FOR (node:Weather) REQUIRE (node.weather_id) IS UNIQUE;
:commit
CALL db.awaitIndexes(300);
:begin
UNWIND [{place_id:1, properties:{place_key:"home"}}, {place_id:2, properties:{place_key:"cafe"}}, {place_id:3, properties:{place_key:"office"}}, {place_id:4, properties:{place_key:"park"}}, {place_id:5, properties:{place_key:"beach"}}, {place_id:6, properties:{place_key:"mountain"}}, {place_id:7, properties:{place_key:"library"}}, {place_id:8, properties:{place_key:"restaurant"}}, {place_id:9, properties:{place_key:"bar"}}, {place_id:10, properties:{place_key:"studio"}}, {place_id:11, properties:{place_key:"bedroom"}}, {place_id:12, properties:{place_key:"rooftop"}}, {place_id:13, properties:{place_key:"car"}}, {place_id:14, properties:{place_key:"train"}}, {place_id:15, properties:{place_key:"bookstore"}}] AS row
CREATE (n:Place{place_id: row.place_id}) SET n += row.properties;
UNWIND [{pattern_id:"cozy_evening_snowy_home_partner", properties:{mood_combo:["cozy"], frequency:1}}, {pattern_id:"crisp_dawn_rainy_home_alone", properties:{mood_combo:["crisp"], frequency:1}}, {pattern_id:"romantic_afternoon_rainy_library_partner", properties:{mood_combo:["romantic"], frequency:1}}, {pattern_id:"cozy_dawn_rainy_studio_partner", properties:{mood_combo:["cozy"], frequency:1}}, {pattern_id:"cozy-refreshing_dawn_cloudy_home_partner", properties:{mood_combo:["cozy", "refreshing"], frequency:1}}] AS row
CREATE (n:VibePattern{pattern_id: row.pattern_id}) SET n += row.properties;
UNWIND [{name:"드라마", properties:{}}, {name:"스릴러", properties:{}}, {name:"코미디", properties:{}}, {name:"미스터리", properties:{}}, {name:"액션", properties:{}}, {name:"호러", properties:{}}, {name:"로맨스", properties:{}}, {name:"SF", properties:{}}, {name:"모험", properties:{}}, {name:"뮤지컬", properties:{}}, {name:"역사", properties:{}}, {name:"범죄", properties:{}}, {name:"K-Pop", properties:{}}, {name:"발라드", properties:{}}, {name:"디스코", properties:{}}, {name:"댄스", properties:{}}, {name:"R&B", properties:{}}, {name:"팝", properties:{}}, {name:"힙합", properties:{}}, {name:"인디팝", properties:{}}, {name:"일렉트로닉", properties:{}}, {name:"록", properties:{}}, {name:"프로그레시브", properties:{}}, {name:"신스팝", properties:{}}, {name:"댄스팝", properties:{}}, {name:"소프트록", properties:{}}] AS row
CREATE (n:Genre{name: row.name}) SET n += row.properties;
UNWIND [{item_id:1, properties:{overview:"전원 백수인 기택 가족이 부유한 박 사장네 집에 하나씩 침투하면서 벌어지는 이야기", tmdb_id:496243, keywords:["계급", "빈부격차"], image_url:"https://image.tmdb.org/t/p/w500/7IiTTgloJzvGI1TAYymCfbfl3vT.jpg", genres:["드라마", "스릴러", "코미디"], item_key:"movie_tmdb_496243", vote_average:8.5, name:"기생충", runtime:132, external_service:"NETFLIX", external_link:"https://www.netflix.com/title/81257639"}}, {item_id:2, properties:{overview:"이유도 모른 채 15년간 감금된 남자의 처절한 복수극", tmdb_id:670, keywords:["복수", "감금"], image_url:"https://image.tmdb.org/t/p/w500/uUwMwJzFmPDFmcGJfFGEq7MbX0n.jpg", genres:["스릴러", "미스터리", "드라마"], item_key:"movie_tmdb_670", vote_average:8.3, name:"올드보이", runtime:120, external_service:"OTHER", external_link:"https://watcha.com/contents/m1234"}}, {item_id:3, properties:{overview:"부산행 KTX에서 벌어지는 좀비 바이러스 서바이벌", tmdb_id:396535, keywords:["좀비", "기차"], image_url:"https://image.tmdb.org/t/p/w500/kFCjfRvMCFkYBQoIONOBwbQmMP3.jpg", genres:["액션", "호러", "스릴러"], item_key:"movie_tmdb_396535", vote_average:7.8, name:"부산행", runtime:118, external_service:"NETFLIX", external_link:"https://www.netflix.com/title/80108983"}}, {item_id:4, properties:{overview:"아칸소주 시골로 이주한 한국인 가족의 아메리칸 드림", tmdb_id:615643, keywords:["이민", "가족"], image_url:"https://image.tmdb.org/t/p/w500/7RyBmEpegJDjOEGOUkNPpC5HBIL.jpg", genres:["드라마"], item_key:"movie_tmdb_615643", vote_average:7.5, name:"미나리", runtime:115, external_service:"OTHER"}}, {item_id:5, properties:{overview:"산악 사고 사건을 조사하는 형사가 용의자에게 빠져드는 미스터리 로맨스", tmdb_id:906221, keywords:["형사", "용의자"], image_url:"https://image.tmdb.org/t/p/w500/tRF6Mhh0I6jr7VpNzH9GJRzIfPU.jpg", genres:["미스터리", "로맨스", "드라마"], item_key:"movie_tmdb_906221", vote_average:7.3, name:"헤어질 결심", runtime:138, external_service:"OTHER"}}, {item_id:6, properties:{overview:"인류의 생존을 위해 웜홀을 통과해 새로운 행성을 찾는 우주 탐험", tmdb_id:157336, keywords:["우주", "시간여행"], image_url:"https://image.tmdb.org/t/p/w500/gEU2QniE6E77NI6lCU6MxlNBvIx.jpg", genres:["SF", "드라마", "모험"], item_key:"movie_tmdb_157336", vot